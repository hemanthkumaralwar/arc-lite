# Copy this file to backend\.env and fill in real values. Never commit .env.
# Postgres — your database connection

DATABASE_URL = your_database_url_from_neon_website
DATABASE_URL_POOLED = your_pooled_database_url_from_neon_website

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRY_HOURS=8
ENABLE_LLM_ASSIST=true

#gemini api - your llm connection

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite